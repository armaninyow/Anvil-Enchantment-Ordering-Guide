{
	"schemaVersion": 1,
	"id": "aeog",
	"version": "${version}",
	"name": "Anvil Enchantment Ordering Guide",
	"description": "Embeds an optimization engine into the Anvil GUI to find the cheapest enchantment merge order.\n\nAcknowledgements:\nMinecraft Enchantment Ordering Tool by iamcal:\nhttps://github.com/iamcal/enchant-order",
	"authors": [
		"Armaninyow"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/anvil-enchantment-ordering-guide",
		"sources": "https://github.com/armaninyow/Anvil-Enchantment-Ordering-Guide",
		"issues": "https://github.com/armaninyow/Anvil-Enchantment-Ordering-Guide/discussions/categories/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/aeog/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.armaninyow.aeog.AnvilEnchantmentOrderingGuide"
		],
		"client": [
			"com.armaninyow.aeog.client.AeogClient"
		],
		"modmenu": [
			"com.armaninyow.dibs.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"aeog.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": ">=1.21.2 <1.21.6",
		"java": ">=21",
		"fabric-api": "*",
		"cloth-config": "*",
		"modmenu": "*"
	}
}
